# 复制为 .env 后填入真值。.env 永不进 git。

# 主力模型：日常开发用便宜的，跑 evals 和调难题时切换
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# 默认模型标识，格式 provider:model，供 init_chat_model 使用
DEFAULT_MODEL=deepseek:deepseek-chat

# LangSmith 可观测。第 2 周就接上，它是唯一的调试手段。
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agent-learning

# agent 护栏：无限循环会烧钱
MAX_AGENT_ITERATIONS=10
LLM_TIMEOUT_SECONDS=60
